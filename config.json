{
  "server": {
    "port": 8000,
    "host": "0.0.0.0"
  },
  "serial": {
    "port": "/dev/ttyUSB0",
    "baudrate": 38400,
    "timeout": 1.0,
    "protocol": "elm327"
  },
  "bluetooth": {
    "enabled": false,
    "rfcomm_channel": 1
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}